---
import { TOOL_LABELS } from '../lib/site';

interface Props {
  tools: string[];
  inputs?: string[];
}

const { tools, inputs = [] } = Astro.props;
---

<ul class="tags mono">
  {tools.map((t) => <li>{TOOL_LABELS[t] ?? t}</li>)}
  {inputs.map((i) => <li class="input">{i}</li>)}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    color: var(--muted);
  }

  .input {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>
